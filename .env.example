# ---------------------------------------------------------------------------
# Al-Marsad — local server configuration (copy to .env)
# ---------------------------------------------------------------------------
PORT=3000
HOST=0.0.0.0

# auto | google | deepl | libre | free | none
#   auto  = google if a key exists, else deepl, else libre, else the keyless endpoint
#   none  = disable server-side translation (the frontend falls back to the browser)
TRANSLATE_PROVIDER=auto

# Optional paid providers (most reliable, no rate limits)
# GOOGLE_TRANSLATE_API_KEY=
# DEEPL_API_KEY=

# Optional self-hosted LibreTranslate
# LIBRE_TRANSLATE_URL=http://localhost:5000
# LIBRE_TRANSLATE_API_KEY=

# Ingestion limits
# MAX_BLOCKS=120
# FETCH_TIMEOUT_MS=15000
# MAX_PAGE_BYTES=1800000
# ARTICLE_CACHE_TTL_MS=600000
# FEED_CACHE_TTL_MS=480000

# Set to 1 ONLY for local testing against a fixture server on 127.0.0.1
# ALLOW_PRIVATE_HOSTS=0

# debug | info
LOG_LEVEL=info
